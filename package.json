{
  "name": "stealth-browser-automation-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local diagnostics & authorized-automation lab: observe, reproduce, analyze and debug your own browser/Extranet workflows against a bundled mock environment — never on a live production account.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "workspaces": [
    "shared",
    "windows-service",
    "mock-extranet",
    "dashboard"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:shared": "node --test --experimental-strip-types shared/test/*.test.ts",
    "test:service": "node --test --experimental-strip-types --experimental-sqlite windows-service/test/*.test.ts",
    "test:mock": "node --test --experimental-strip-types mock-extranet/test/*.test.ts",
    "test:core": "node --test --experimental-strip-types --experimental-sqlite shared/test/*.test.ts windows-service/test/*.test.ts mock-extranet/test/*.test.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "diagnostics",
    "qa",
    "browser-automation",
    "observability",
    "forensics",
    "workflow-replay",
    "mv3-extension"
  ]
}
