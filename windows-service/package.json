{
  "name": "@lab/windows-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local background service: loopback API, JSON event bus, SQLite (WAL), rolling logs, health, watchdog. Zero runtime dependencies (node:http + node:sqlite + node:crypto).",
  "type": "module",
  "bin": {
    "lab-service": "src/index.ts",
    "lab-watchdog": "src/watchdog.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types --experimental-sqlite src/index.ts",
    "watchdog": "node --experimental-strip-types --experimental-sqlite src/watchdog.ts",
    "test": "node --test --experimental-strip-types --experimental-sqlite test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json"
  }
}
