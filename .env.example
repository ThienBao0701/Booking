# STEALTH BROWSER AUTOMATION LAB — example environment config.
# Copy to `.env` (git-ignored). Real values are generated locally at install.

# Local background service (Phase 3+). MUST stay on loopback.
LAB_SERVICE_HOST=127.0.0.1
LAB_SERVICE_PORT=4577

# Auth token for the localhost API. Generated at install; never commit the real
# value. The extension is paired with the same token.
# LAB_AUTH_TOKEN=

# Mock Extranet (Phase 5+).
MOCK_EXTRANET_HOST=127.0.0.1
MOCK_EXTRANET_PORT=4599

# Default safety mode: OBSERVE | SIMULATE | AUTHORIZED_AUTOMATION
LAB_SAFETY_MODE=OBSERVE

# Data directory (SQLite + logs + screenshots). User-owned, local only.
LAB_DATA_DIR=./.lab-runtime

# Dashboard replays (docs/19): operator workflow library (default <LAB_DATA_DIR>/workflows)
# LAB_WORKFLOWS_DIR=
